# ------------------------------------------------------------------
#  Contalexy: configuração do backend. Copia para .env e preenche.
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# PostgreSQL (o docker-compose.yml deste projeto cria uma em localhost:5432)
DATABASE_URL="postgresql://rumo:rumo@localhost:5432/rumo?schema=public"
# Produção com deploy/ (Docker): a base chama-se "postgres" e o Redis "redis":
#   DATABASE_URL="postgresql://rumo:A_PASS@postgres:5432/rumo?schema=public"
#   REDIS_URL=redis://redis:6379
# Base gerida online (Neon, Supabase...): DATABASE_URL="postgresql://U:P@HOST/BASE?sslmode=require"
# e, se o serviço tiver um link "pooler", o link direto para as migrações:
# DIRECT_URL="postgresql://U:P@HOST-DIRETO/BASE?sslmode=require"
# Base de dados criada pelo deploy/docker-compose.prod.yml (a PASS tem de ser a mesma da DATABASE_URL)
POSTGRES_USER=rumo
POSTGRES_PASSWORD=rumo
POSTGRES_DB=rumo

# Segredos das sessões: gera dois diferentes (ex.: openssl rand -base64 48)
JWT_ACCESS_SECRET=troca-isto-por-um-segredo-forte-com-32-ou-mais-caracteres
JWT_REFRESH_SECRET=troca-isto-tambem-por-outro-segredo-diferente-e-longo
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=60

# Endereço público da API (para os links das fotos de perfil)
APP_PUBLIC_URL=http://localhost:3000
# Produção: APP_PUBLIC_URL=https://api.contalexy.com
# Origens permitidas (web). "*" em desenvolvimento.
CORS_ORIGINS=*
# Produção: CORS_ORIGINS=https://contalexy.com,https://www.contalexy.com

# Ficheiros (recibos, fotos): guardados nesta pasta
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=10

# Email (código para recuperar a palavra-passe): https://resend.com
# Sem chave: o email aparece no log do servidor.
RESEND_API_KEY=
MAIL_FROM="Contalexy <noreply@o-teu-dominio.com>"
# Para onde vão as sugestões e problemas enviados pela app (vazio = só na administração)
SUPPORT_EMAIL=

# Entrar com o Google: o "Web client ID" criado na Google Cloud Console
# (Credenciais › ID de cliente OAuth › Aplicação Web). É o mesmo que a app usa
# em GOOGLE_SERVER_CLIENT_ID. Podes pôr vários, separados por vírgulas.
# Vazio = entrar com o Google fica desligado.
GOOGLE_CLIENT_IDS=

# Push (Firebase Cloud Messaging): cola o JSON da service account numa
# linha (Firebase › Definições › Contas de serviço › Gerar chave).
# Sem isto, as notificações ficam só dentro da app.
FIREBASE_SERVICE_ACCOUNT_JSON=

# IA (Claude, Anthropic): https://console.anthropic.com
# Sem chave, o assistente/scanner respondem "ainda não disponível".
ANTHROPIC_API_KEY=
# Se a chave não estiver ligada a um workspace (a API responde "not scoped to a workspace"),
# mete aqui o ID do workspace (Console > Settings > Workspaces, começa por wrkspc_). Senão, deixa vazio.
ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-haiku-4-5-20251001
AI_MODEL_ADVANCED=claude-sonnet-5
# Teto global de custo da IA por mês, em USD (0 = sem teto). A 80% as
# previsões/análises ficam em pausa para o plano grátis; a 100% fica toda a
# IA em pausa para o plano grátis. Quem paga não é afetado.
AI_MONTHLY_BUDGET_USD=0
# Preços dos modelos (USD por milhão de tokens): só para ESTIMAR o custo.
# Confirma os valores atuais em https://www.anthropic.com/pricing
AI_PRICE_INPUT_PER_MTOK=1
AI_PRICE_OUTPUT_PER_MTOK=5
AI_PRICE_ADVANCED_INPUT_PER_MTOK=3
AI_PRICE_ADVANCED_OUTPUT_PER_MTOK=15

# Pagamentos (RevenueCat: App Store + Google Play + web)
# REVENUECAT_WEBHOOK_AUTH = o valor que pões em "Authorization header" no webhook do RevenueCat.
# Usa um valor longo e aleatório (ex.: `openssl rand -hex 32`): é a chave que impede avisos falsos.
REVENUECAT_WEBHOOK_AUTH=
# Chave secreta (sk_...): o servidor confirma cada compra diretamente junto do RevenueCat
# (depois de cada webhook e em /billing/sync). Sem ela, vale só o webhook.
REVENUECAT_SECRET_API_KEY=
# Só para testes: deixa dar Premium a ti próprio (POST /v1/billing/dev/grant).
# Com NODE_ENV=production não funciona, mesmo que fique a true.
BILLING_DEV_GRANTS=false
# As compras de teste das lojas (sandbox) dão acesso? Só testadores de licença da Google
# e contas sandbox/revisores da Apple as conseguem fazer; clientes normais nunca.
# Vazio = true em desenvolvimento e false em produção. Em produção põe true só
# enquanto a Apple revê a app (o revisor compra em sandbox) e volta a pôr false.
# As compras de teste nunca contam para a receita.
BILLING_ACCEPT_SANDBOX=

# Administração (o /admin do site contalex-web usa /v1/admin/*): emails das contas que
# são administradoras, separados por vírgulas. Cria PRIMEIRO a tua conta na
# app e só depois mete aqui o email.
ADMIN_EMAILS=
# Comissão da loja a assumir no relatório de receita quando a loja não a
# comunica (0.15 = 15%). É só para a estimativa do que chega à conta.
STORE_COMMISSION_DEFAULT=0.15

# Promoções do Premium (sem spam)
PROMOTIONS_ENABLED=true
PROMOTIONS_GLOBAL_GAP_HOURS=20

# Câmbios (gratuito, sem chave)
EXCHANGE_RATES_ENABLED=true
EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/EUR

# Tarefas agendadas (pagamentos recorrentes, lembretes, câmbios, assinaturas)
JOBS_ENABLED=true

# ---------------------------------------------------------------- Parte 9 e 10
# Ficheiros: local (pasta UPLOADS_DIR) ou s3 (DigitalOcean Spaces ou outro S3).
# No Spaces: endpoint https://<região>.digitaloceanspaces.com, bucket = nome do Space,
# chaves em API > Spaces Keys. Os recibos ficam privados (endereços temporários);
# fotos de perfil e logótipos ficam públicos (ACL public-read). S3_PUBLIC_URL = o CDN do Space.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_SIGNED_SECONDS=900

# Redis (cache, limites de pedidos, idempotência). Vazio = em memória (só um processo).
REDIS_URL=

# IA: limite curto por pessoa (renova sozinho) e pacotes de créditos à venda na loja (produto:créditos)
AI_BURST_WINDOW_MINUTES=10
AI_BURST_LIMIT_FREE=5
AI_BURST_LIMIT_PAID=25
AI_CREDIT_PRODUCTS=contalex_ai_credits_50:50,contalex_ai_credits_200:200

# WhatsApp (Meta Cloud API). Vazios = desligado. Webhook: https://<servidor>/v1/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v20.0
# Mensagens tratadas por número por dia (protege contra spam e custos)
WHATSAPP_DAILY_LIMIT=60
